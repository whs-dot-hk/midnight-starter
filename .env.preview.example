# Copy this to .env.preview and fill it in. midnight-starter loads .env.preview
# when --env preview (or MN_ENV=preview) is selected. Variables already set in
# the shell win over this file.

# Password of the cardano-db-sync Postgres, used by `db_sync_postgres` in
# envs/preview.yaml. Expanded when the nodes start, never written to data/.
DBSYNC_PASSWORD=replace-with-your-postgres-password
